@page "/createcourse"
@using static ModuloLMS.Models.Course
@model ModuloLMS.Pages.CoursePages.CreateCourseModel
@{
    ViewData["Title"] = "Create Course";
}

<form method="post" class="d-flex flex-column w-75 mx-auto ">
    <h1>Create Course</h1>
    <div class="mb-4">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <span class="text-danger">*</span>
            <label asp-for="Course.CourseTitle" class="control-label" aria-required="true"></label>
            <input asp-for="Course.CourseTitle" class="form-control"></input>
            <span asp-validation-for="Course.CourseTitle"></span>
        </div>
         <div class="mb-3">
             @* TODO: Add drop down for loaded instructors departments *@
            <span class="text-danger">*</span>
            <label @* asp-for="Course.Department" *@ class="control-label" aria-required="true"></label>
            <select @* asp-items="Instructor.Departments" *@>
                <option>Select Department</option>
            </select>
        </div>
        <div class="mb-3">
            <span class="text-danger">*</span>
            <label asp-for="Course.CourseNumber" class="control-label" aria-required="true"></label>
            <input asp-for="Course.CourseNumber" class="form-control"></input>
            <span asp-validation-for="Course.CourseNumber"></span>
        </div>
        <div class="mb-3">
            <span class="text-danger">*</span>
            <label asp-for="Course.CourseDescription" class="control-label" aria-required="true"></label>
            <input asp-for="Course.CourseDescription" class="form-control"></input>
            <span asp-validation-for="Course.CourseDescription"></span>
        </div>
        <div class="mb-3">
            <span class="text-danger">*</span>
            <label asp-for="Course.CourseCapacity" class="control-label" aria-required="true"></label>
            <input asp-for="Course.CourseCapacity" class="form-control"></input>
            <span asp-validation-for="Course.CourseCapacity"></span>
        </div>
        <div class="mb-3">
            <span class="text-danger">*</span>
            <label asp-for="Course.Credits" class="control-label" aria-required="true"></label>
            <input asp-for="Course.Credits" class="form-control"></input>
            <span asp-validation-for="Course.Credits"></span>
        </div>
        <div class="mb-3 flex-column d-flex column-gap-4">
            <label asp-for="Course.ClassTimes" class="control-label"></label>
            @for (int i = 0; i < Model.ClassTimes.Count; i++)
            {
                <div class="d-flex flex-row gap-4 my-2 py-1 border-2 border-top border-bottom">
                    <div class="d-flex flex-column">
                        <label class="control-labe mb-1">Day of Week</label>
                        <select asp-for="ClassTimes[i].DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()">
                            <option>Select Day of Week</option>
                        </select>
                    </div>
                    <div class="d-flex flex-column">
                        <label class="control-label mb-1">Start Time</label>
                        <input asp-for="ClassTimes[i].StartTime" type="time"/>
                    </div>
                    <div class="d-flex flex-column">
                        <label class="control-label mb-1">End Time</label>
                        <input asp-for="ClassTimes[i].EndTime" type="time"/>
                    </div>
                    <input type="submit" value="Delete Class Time" class="btn btn-outline-danger h-50 my-auto align-content-end" asp-page-handler="DeleteTime" asp-route-index="@i"/>
                </div>
            }
            <input type="submit" value="Add Time" class="btn btn-outline-primary w-25" asp-page-handler="AddTime"/>
            <span asp-validation-for="Course.ClassTimes"></span>
        </div>
    </div>
    <input type="submit" value="Create Course" class="btn btn w-50 btn-primary mx-auto" asp-page-handler="Submit"/>
</form>